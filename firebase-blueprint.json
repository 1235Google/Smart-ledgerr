{
  "entities": {
    "Notification": {
      "title": "Notification",
      "description": "Real application notifications for users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "type": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "read": {
          "type": "boolean"
        },
        "userId": {
          "type": "string"
        },
        "referenceId": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "message",
        "type",
        "createdAt",
        "read",
        "userId"
      ]
    }
  },
  "firestore": {
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
